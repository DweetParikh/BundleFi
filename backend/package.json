{
  "name": "bundlefi-backend",
  "version": "1.0.0",
  "description": "BundleFi REST API — Solana crypto bundle investment backend",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "db:generate": "prisma generate --schema=./src/db/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema=./src/db/prisma/schema.prisma",
    "db:push": "prisma db push --schema=./src/db/prisma/schema.prisma",
    "db:studio": "prisma studio --schema=./src/db/prisma/schema.prisma",
    "db:seed": "node src/db/seed.js"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/rate-limit": "^9.1.0",
    "@prisma/client": "^5.14.0",
    "@solana/web3.js": "^1.95.4",
    "dotenv": "^16.4.5",
    "fast-jwt": "^6.2.4",
    "fastify": "^4.29.1",
    "ioredis": "^5.4.1",
    "node-cron": "^3.0.3",
    "pino-pretty": "^13.1.3",
    "tweetnacl": "^1.0.3",
    "zod": "^3.23.8"
  },
  "overrides": {
    "jayson": "^4.1.3",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "prisma": "^5.14.0"
  }
}
