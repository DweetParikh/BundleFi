{
  "name": "bundlefi-backend",
  "version": "1.0.0",
  "description": "BundleFi REST API — Solana crypto bundle investment backend",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev":        "node --watch src/server.js",
    "start":      "node src/server.js",
    "db:generate":"prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push":    "prisma db push",
    "db:studio":  "prisma studio",
    "db:seed":    "node src/db/seed.js"
  },
  "dependencies": {
    "@fastify/cors":        "^9.0.1",
    "@fastify/rate-limit":  "^9.1.0",
    "fast-jwt":             "^4.0.0",
    "@prisma/client":       "^5.14.0",
    "@solana/web3.js":      "^1.95.4",
    "dotenv":               "^16.4.5",
    "fastify":              "^4.28.1",
    "ioredis":              "^5.4.1",
    "node-cron":            "^3.0.3",
    "tweetnacl":            "^1.0.3",
    "zod":                  "^3.23.8"
  },
  "devDependencies": {
    "prisma": "^5.14.0"
  }
}
